{
  "$defs": {
    "ConversationState": {
      "additionalProperties": false,
      "properties": {
        "confirmed_profile": {
          "$ref": "#/$defs/HealthProfile"
        },
        "current_field": {
          "anyOf": [
            {
              "enum": [
                "age",
                "sex",
                "height_cm",
                "weight_kg",
                "sleep_hours",
                "exercise_minutes_weekly",
                "smoking_status",
                "alcohol_drinks_weekly",
                "diabetes",
                "systolic_bp",
                "diastolic_bp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Field"
        },
        "pending_profile": {
          "$ref": "#/$defs/HealthProfile"
        },
        "phase": {
          "default": "idle",
          "enum": [
            "idle",
            "asking",
            "confirming",
            "ready",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "skipped_fields": {
          "items": {
            "enum": [
              "age",
              "sex",
              "height_cm",
              "weight_kg",
              "sleep_hours",
              "exercise_minutes_weekly",
              "smoking_status",
              "alcohol_drinks_weekly",
              "diabetes",
              "systolic_bp",
              "diastolic_bp"
            ],
            "type": "string"
          },
          "maxItems": 11,
          "title": "Skipped Fields",
          "type": "array"
        }
      },
      "required": [
        "phase",
        "confirmed_profile",
        "pending_profile",
        "current_field",
        "skipped_fields"
      ],
      "title": "ConversationState",
      "type": "object"
    },
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 280,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        }
      },
      "required": [
        "age",
        "sex",
        "height_cm",
        "weight_kg",
        "sleep_hours",
        "exercise_minutes_weekly",
        "smoking_status",
        "alcohol_drinks_weekly",
        "diabetes",
        "systolic_bp",
        "diastolic_bp"
      ],
      "title": "HealthProfile",
      "type": "object"
    },
    "MascotEvent": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "state": {
          "enum": [
            "asking",
            "thinking",
            "confirming",
            "celebrating",
            "idle"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "caption"
      ],
      "title": "MascotEvent",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_input_modes": {
      "items": {
        "enum": [
          "text",
          "transcript"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Accepted Input Modes",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "guide_mode": {
      "default": "guided",
      "enum": [
        "guided",
        "llm"
      ],
      "title": "Guide Mode",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Limitations",
      "type": "array"
    },
    "mascot_events": {
      "items": {
        "$ref": "#/$defs/MascotEvent"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Mascot Events",
      "type": "array"
    },
    "message": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "provider_status": {
      "default": "not_configured",
      "enum": [
        "not_configured",
        "consent_required",
        "used",
        "unavailable",
        "not_needed"
      ],
      "title": "Provider Status",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ConversationState"
    },
    "voice_status": {
      "default": "deferred",
      "enum": [
        "deferred",
        "available",
        "unavailable"
      ],
      "title": "Voice Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "state",
    "message",
    "guide_mode",
    "provider_status",
    "voice_status",
    "accepted_input_modes",
    "mascot_events",
    "complete",
    "limitations"
  ],
  "title": "TurnResponse",
  "type": "object"
}
