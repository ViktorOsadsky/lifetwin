{
  "$defs": {
    "ChangeState": {
      "additionalProperties": false,
      "properties": {
        "doctor_said": {
          "default": false,
          "title": "Doctor Said",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "age",
                "sex",
                "height_cm",
                "weight_kg",
                "sleep_hours",
                "exercise_minutes_weekly",
                "smoking_status",
                "alcohol_drinks_weekly",
                "diabetes",
                "systolic_bp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "metric": {
          "default": false,
          "title": "Metric",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "options": {
          "items": {
            "enum": [
              "age",
              "sex",
              "height_cm",
              "weight_kg",
              "sleep_hours",
              "exercise_minutes_weekly",
              "smoking_status",
              "alcohol_drinks_weekly",
              "diabetes",
              "systolic_bp"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Options",
          "type": "array"
        },
        "pending": {
          "$ref": "#/$defs/HealthProfile"
        },
        "phase": {
          "default": "choosing",
          "enum": [
            "choosing",
            "asking",
            "probing",
            "confirming",
            "done",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "probed": {
          "default": false,
          "title": "Probed",
          "type": "boolean"
        },
        "saved": {
          "$ref": "#/$defs/HealthProfile"
        }
      },
      "title": "ChangeState",
      "type": "object"
    },
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "general_health": {
          "anyOf": [
            {
              "enum": [
                "excellent",
                "very_good",
                "good",
                "fair",
                "poor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "General Health"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 280,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "hypertension_diagnosed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypertension Diagnosed"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        }
      },
      "title": "HealthProfile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "reply",
        "confirm",
        "cancel",
        "resume"
      ],
      "title": "Action",
      "type": "string"
    },
    "input_mode": {
      "default": "text",
      "enum": [
        "text",
        "transcript"
      ],
      "title": "Input Mode",
      "type": "string"
    },
    "memory_consent": {
      "default": false,
      "title": "Memory Consent",
      "type": "boolean"
    },
    "profile": {
      "$ref": "#/$defs/HealthProfile"
    },
    "state": {
      "$ref": "#/$defs/ChangeState"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "required": [
    "action",
    "state"
  ],
  "title": "ChangeTurnRequest",
  "type": "object"
}
