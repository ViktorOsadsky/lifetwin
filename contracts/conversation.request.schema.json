  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "start",
        "reply",
        "confirm",
        "correct",
        "skip",
        "cancel",
        "import",
        "resume"
      ],
      "title": "Action",
      "type": "string"
    },
    "field": {
      "anyOf": [
        {
          "enum": [
            "age",
            "sex",
            "height_cm",
            "weight_kg",
            "sleep_hours",
            "exercise_minutes_weekly",
            "smoking_status",
            "alcohol_drinks_weekly",
            "diabetes",
            "systolic_bp",
            "diastolic_bp",
            "general_health",
            "hypertension_diagnosed",
            "sedentary_min_day",
            "moderate_recreation_min_week",
            "vigorous_recreation_min_week"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "input_mode": {
      "default": "text",
      "enum": [
        "text",
        "transcript"
      ],
      "title": "Input Mode",
      "type": "string"
    },
    "outside_ai_consent": {
      "additionalProperties": {
        "type": "boolean"
      },
      "propertyNames": {
        "enum": [
          "claude",
          "muse"
        ]
      },
      "title": "Outside Ai Consent",
      "type": "object"
    },
    "provider_consent": {
      "default": false,
      "title": "Provider Consent",
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/ConversationState"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "values": {
      "anyOf": [
        {
          "$ref": "#/$defs/HealthProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "action"
  ],
  "title": "TurnRequest",
  "type": "object"
}
