{
  "$defs": {
    "CheckinValues": {
      "additionalProperties": false,
      "description": "Answers from a daily or weekly check-in, in the profile's own units and ranges.\n\nWeekly answers use the profile's field names, so a caller can offer them as\nprofile updates. Daily answers are about one night or one day and have their\nown names, so they never pass for a usual week.",
      "properties": {
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "alcohol_drinks_yesterday": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Yesterday"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_today": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Today"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "sleep_hours_last_night": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Last Night"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "wellbeing": {
          "anyOf": [
            {
              "enum": [
                "good",
                "okay",
                "not_great"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wellbeing"
        }
      },
      "title": "CheckinValues",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "daily",
        "weekly"
      ],
      "title": "Kind",
      "type": "string"
    },
    "local_date": {
      "anyOf": [
        {
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Date"
    },
    "previous": {
      "$ref": "#/$defs/CheckinValues"
    }
  },
  "required": [
    "kind"
  ],
  "title": "CheckinStartRequest",
  "type": "object"
}
