{
  "$defs": {
    "CheckinValues": {
      "additionalProperties": false,
      "description": "Answers from a daily or weekly check-in, in the profile's own units and ranges.\n\nWeekly answers use the profile's field names, so a caller can offer them as\nprofile updates. Daily answers are about one night or one day and have their\nown names, so they never pass for a usual week.",
      "properties": {
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "alcohol_drinks_yesterday": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Yesterday"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_today": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Today"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "moderate_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "sleep_hours_last_night": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Last Night"
        },
        "sleep_hours_night_before": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Night Before"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "wellbeing": {
          "anyOf": [
            {
              "enum": [
                "good",
                "okay",
                "not_great"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wellbeing"
        }
      },
      "title": "CheckinValues",
      "type": "object"
    },
    "QuickPlan": {
      "additionalProperties": false,
      "description": "What the quick check-in asks, chosen on the phone from the stored history.",
      "properties": {
        "activity_day": {
          "default": "yesterday",
          "enum": [
            "today",
            "yesterday"
          ],
          "title": "Activity Day",
          "type": "string"
        },
        "catch_up": {
          "default": false,
          "title": "Catch Up",
          "type": "boolean"
        },
        "suggested": {
          "$ref": "#/$defs/QuickSuggestions"
        },
        "topics": {
          "items": {
            "enum": [
              "sleep",
              "activity",
              "sitting",
              "feeling"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Topics",
          "type": "array"
        }
      },
      "title": "QuickPlan",
      "type": "object"
    },
    "QuickSuggestions": {
      "additionalProperties": false,
      "description": "Apple Health values for the quick check-in, read on the phone and not yet\nconfirmed. Mochi reads each back (\"Looks right?\"); nothing is kept without a yes.",
      "properties": {
        "activity_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Minutes"
        },
        "sleep_hours_last_night": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Last Night"
        },
        "sleep_hours_night_before": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Night Before"
        }
      },
      "title": "QuickSuggestions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "daily",
        "weekly",
        "quick"
      ],
      "title": "Kind",
      "type": "string"
    },
    "local_date": {
      "anyOf": [
        {
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Date"
    },
    "previous": {
      "$ref": "#/$defs/CheckinValues"
    },
    "quick": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuickPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind"
  ],
  "title": "CheckinStartRequest",
  "type": "object"
}
