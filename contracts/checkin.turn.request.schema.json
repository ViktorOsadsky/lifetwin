{
  "$defs": {
    "CheckinState": {
      "additionalProperties": false,
      "properties": {
        "activity_day": {
          "anyOf": [
            {
              "enum": [
                "today",
                "yesterday"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Day"
        },
        "confirmed": {
          "$ref": "#/$defs/CheckinValues"
        },
        "current_field": {
          "anyOf": [
            {
              "enum": [
                "sleep_hours_last_night",
                "exercise_minutes_today",
                "alcohol_drinks_yesterday",
                "wellbeing",
                "sleep_hours",
                "exercise_minutes_weekly",
                "alcohol_drinks_weekly",
                "smoking_status",
                "weight_kg",
                "systolic_bp",
                "diastolic_bp",
                "sleep_hours_night_before",
                "vigorous_recreation_min",
                "moderate_recreation_min",
                "sedentary_min_day",
                "vigorous_recreation_min_week",
                "moderate_recreation_min_week"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Field"
        },
        "from_health": {
          "default": false,
          "title": "From Health",
          "type": "boolean"
        },
        "held_minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Held Minutes"
        },
        "kind": {
          "enum": [
            "daily",
            "weekly",
            "quick"
          ],
          "title": "Kind",
          "type": "string"
        },
        "local_date": {
          "anyOf": [
            {
              "pattern": "\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Date"
        },
        "one_pace": {
          "default": false,
          "title": "One Pace",
          "type": "boolean"
        },
        "pending": {
          "$ref": "#/$defs/CheckinValues"
        },
        "phase": {
          "default": "asking",
          "enum": [
            "asking",
            "confirming",
            "ready",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/CheckinValues"
        },
        "questions": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "skipped_fields": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "title": "Skipped Fields",
          "type": "array"
        },
        "suggested": {
          "$ref": "#/$defs/CheckinValues"
        },
        "suggested_activity_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Activity Min"
        }
      },
      "required": [
        "kind",
        "questions"
      ],
      "title": "CheckinState",
      "type": "object"
    },
    "CheckinValues": {
      "additionalProperties": false,
      "description": "Answers from a daily or weekly check-in, in the profile's own units and ranges.\n\nWeekly answers use the profile's field names, so a caller can offer them as\nprofile updates. Daily answers are about one night or one day and have their\nown names, so they never pass for a usual week.",
      "properties": {
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "alcohol_drinks_yesterday": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Yesterday"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_today": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Today"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "moderate_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "sleep_hours_last_night": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Last Night"
        },
        "sleep_hours_night_before": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Night Before"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "wellbeing": {
          "anyOf": [
            {
              "enum": [
                "good",
                "okay",
                "not_great"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wellbeing"
        }
      },
      "title": "CheckinValues",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "reply",
        "confirm",
        "skip",
        "cancel",
        "resume"
      ],
      "title": "Action",
      "type": "string"
    },
    "input_mode": {
      "default": "text",
      "enum": [
        "text",
        "transcript"
      ],
      "title": "Input Mode",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CheckinState"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "required": [
    "action",
    "state"
  ],
  "title": "CheckinTurnRequest",
  "type": "object"
}
