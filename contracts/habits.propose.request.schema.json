{
  "$defs": {
    "HabitRecord": {
      "additionalProperties": false,
      "description": "One habit as the phone stores it (the design's ``Habit``).",
      "properties": {
        "anchor": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "catalog_id": {
          "enum": [
            "morning_daylight",
            "steady_bedtime",
            "walk_after_lunch",
            "brisk_walk",
            "stand_on_calls",
            "three_breaths",
            "text_a_friend",
            "water_with_meals",
            "quit_help"
          ],
          "title": "Catalog Id",
          "type": "string"
        },
        "dismissed_until": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dismissed Until"
        },
        "id": {
          "pattern": "^[a-z0-9_-]{1,48}$",
          "title": "Id",
          "type": "string"
        },
        "lever": {
          "anyOf": [
            {
              "enum": [
                "quit_smoking",
                "vigorous_activity",
                "moderate_activity",
                "sleep",
                "sitting"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lever"
        },
        "pillar": {
          "enum": [
            "move",
            "sleep",
            "sit_less",
            "unwind",
            "smoke_free",
            "connect",
            "nourish"
          ],
          "title": "Pillar",
          "type": "string"
        },
        "source": {
          "enum": [
            "said",
            "model_lever",
            "guideline"
          ],
          "title": "Source",
          "type": "string"
        },
        "started_on": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started On"
        },
        "status": {
          "enum": [
            "proposed",
            "active",
            "dismissed",
            "graduated"
          ],
          "title": "Status",
          "type": "string"
        },
        "tiny_action": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tiny Action",
          "type": "string"
        },
        "why_words": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Words"
        }
      },
      "required": [
        "id",
        "catalog_id",
        "pillar",
        "anchor",
        "tiny_action",
        "source",
        "status"
      ],
      "title": "HabitRecord",
      "type": "object"
    },
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 280,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        }
      },
      "title": "HealthProfile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "age": {
      "maximum": 120,
      "minimum": 0,
      "title": "Age",
      "type": "integer"
    },
    "habits": {
      "items": {
        "$ref": "#/$defs/HabitRecord"
      },
      "maxItems": 20,
      "title": "Habits",
      "type": "array"
    },
    "local_date": {
      "maxLength": 10,
      "minLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Local Date",
      "type": "string"
    },
    "memory_consent": {
      "default": false,
      "title": "Memory Consent",
      "type": "boolean"
    },
    "own_words": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Own Words",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/HealthProfile"
    },
    "sitting_minutes_daily": {
      "anyOf": [
        {
          "maximum": 1440,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sitting Minutes Daily"
    }
  },
  "required": [
    "age",
    "local_date"
  ],
  "title": "HabitProposeRequest",
  "type": "object"
}
