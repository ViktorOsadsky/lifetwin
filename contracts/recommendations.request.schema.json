{
  "$defs": {
    "DocumentContext": {
      "additionalProperties": false,
      "description": "What the person confirmed from health documents, kept on the phone with no expiry\nuntil Delete my data (owner ruling 2026-10-25). The phone sends it only with memory\nconsent. Informational: it is never a model input, never ranks or changes a plan,\nand is never sent to a provider.",
      "properties": {
        "diagnoses": {
          "items": {
            "enum": [
              "diabetes",
              "hypertension"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Diagnoses",
          "type": "array"
        },
        "readings": {
          "items": {
            "$ref": "#/$defs/Reading"
          },
          "maxItems": 40,
          "title": "Readings",
          "type": "array"
        }
      },
      "title": "DocumentContext",
      "type": "object"
    },
    "HabitNote": {
      "additionalProperties": false,
      "description": "What the person said about a habit, in short words taken from their reply.\n\nNotes are never health values and are never used by the model. They are returned\nto the app, which keeps them on the phone; the server stores nothing.",
      "properties": {
        "barrier": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barrier"
        },
        "bedtime": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bedtime"
        },
        "concern": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concern"
        },
        "estimate": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate"
        },
        "estimate_for": {
          "anyOf": [
            {
              "enum": [
                "age",
                "sex",
                "height_cm",
                "weight_kg",
                "sleep_hours",
                "exercise_minutes_weekly",
                "smoking_status",
                "alcohol_drinks_weekly",
                "diabetes",
                "systolic_bp",
                "diastolic_bp",
                "general_health",
                "hypertension_diagnosed",
                "sedentary_min_day",
                "moderate_recreation_min_week",
                "vigorous_recreation_min_week"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate For"
        },
        "feeling": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feeling"
        },
        "frequency": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "naps": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Naps"
        },
        "quit_ago": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quit Ago"
        },
        "quit_aid": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quit Aid"
        },
        "reading": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading"
        },
        "smoked_years": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoked Years"
        },
        "source": {
          "default": "said",
          "enum": [
            "said",
            "ai_helper"
          ],
          "title": "Source",
          "type": "string"
        },
        "time_of_day": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Of Day"
        },
        "topic": {
          "enum": [
            "exercise",
            "sleep",
            "smoking",
            "sitting",
            "health"
          ],
          "title": "Topic",
          "type": "string"
        },
        "tried_quitting": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tried Quitting"
        },
        "wake_time": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wake Time"
        },
        "wakes_for": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wakes For"
        },
        "with": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "With"
        }
      },
      "required": [
        "topic"
      ],
      "title": "HabitNote",
      "type": "object"
    },
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "general_health": {
          "anyOf": [
            {
              "enum": [
                "excellent",
                "very_good",
                "good",
                "fair",
                "poor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "General Health"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 280,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "hypertension_diagnosed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypertension Diagnosed"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        }
      },
      "title": "HealthProfile",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "description": "A confirmed reading the phone keeps over time (owner ruling 2026-10-24): blood\npressure, and A1c or LDL from uploaded documents. Used only for trends and the\ncrisis line; never a diagnosis, never sent to a provider.",
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "field": {
          "enum": [
            "systolic_bp",
            "diastolic_bp",
            "a1c",
            "ldl"
          ],
          "title": "Field",
          "type": "string"
        },
        "source": {
          "enum": [
            "typed",
            "voice",
            "apple_health",
            "document",
            "checkin"
          ],
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "enum": [
            "mmHg",
            "%",
            "mg/dL",
            "mmol/L"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 500,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "field",
        "value",
        "unit",
        "date",
        "source"
      ],
      "title": "Reading",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "excluded_ids": {
      "items": {
        "maxLength": 60,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Excluded Ids",
      "type": "array"
    },
    "habit_notes": {
      "items": {
        "$ref": "#/$defs/HabitNote"
      },
      "maxItems": 10,
      "title": "Habit Notes",
      "type": "array"
    },
    "local_date": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Date"
    },
    "outside_ai_consent": {
      "additionalProperties": {
        "type": "boolean"
      },
      "propertyNames": {
        "enum": [
          "claude",
          "muse"
        ]
      },
      "title": "Outside Ai Consent",
      "type": "object"
    },
    "profile": {
      "$ref": "#/$defs/HealthProfile"
    }
  },
  "required": [
    "profile"
  ],
  "title": "RecommendationRequest",
  "type": "object"
}
