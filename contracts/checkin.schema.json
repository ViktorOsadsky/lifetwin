{
  "$defs": {
    "CheckinState": {
      "additionalProperties": false,
      "properties": {
        "activity_day": {
          "anyOf": [
            {
              "enum": [
                "today",
                "yesterday"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Day"
        },
        "age_band": {
          "anyOf": [
            {
              "enum": [
                "younger",
                "older"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Band"
        },
        "care_line_shown": {
          "default": false,
          "title": "Care Line Shown",
          "type": "boolean"
        },
        "care_question_open": {
          "default": false,
          "title": "Care Question Open",
          "type": "boolean"
        },
        "checking": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Checking",
          "type": "array"
        },
        "confirmed": {
          "$ref": "#/$defs/CheckinValues"
        },
        "current_field": {
          "anyOf": [
            {
              "enum": [
                "sleep_hours_last_night",
                "exercise_minutes_today",
                "alcohol_drinks_yesterday",
                "wellbeing",
                "sleep_hours",
                "exercise_minutes_weekly",
                "alcohol_drinks_weekly",
                "smoking_status",
                "weight_kg",
                "systolic_bp",
                "diastolic_bp",
                "sleep_hours_night_before",
                "vigorous_recreation_min",
                "moderate_recreation_min",
                "sedentary_min_day",
                "vigorous_recreation_min_week",
                "moderate_recreation_min_week"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Field"
        },
        "early": {
          "$ref": "#/$defs/CheckinValues"
        },
        "from_health": {
          "default": false,
          "title": "From Health",
          "type": "boolean"
        },
        "habit_notes": {
          "items": {
            "$ref": "#/$defs/HabitNote"
          },
          "maxItems": 5,
          "title": "Habit Notes",
          "type": "array"
        },
        "held_minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Held Minutes"
        },
        "kind": {
          "enum": [
            "daily",
            "weekly",
            "quick"
          ],
          "title": "Kind",
          "type": "string"
        },
        "local_date": {
          "anyOf": [
            {
              "pattern": "\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Date"
        },
        "memory_consent": {
          "default": false,
          "title": "Memory Consent",
          "type": "boolean"
        },
        "one_pace": {
          "default": false,
          "title": "One Pace",
          "type": "boolean"
        },
        "pending": {
          "$ref": "#/$defs/CheckinValues"
        },
        "phase": {
          "default": "asking",
          "enum": [
            "asking",
            "confirming",
            "probing",
            "ready",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/CheckinValues"
        },
        "probe_asked": {
          "default": false,
          "title": "Probe Asked",
          "type": "boolean"
        },
        "probe_topic": {
          "anyOf": [
            {
              "enum": [
                "exercise",
                "sleep"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Topic"
        },
        "questions": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "reopened": {
          "default": false,
          "title": "Reopened",
          "type": "boolean"
        },
        "skipped_fields": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Skipped Fields",
          "type": "array"
        },
        "suggested": {
          "$ref": "#/$defs/CheckinValues"
        },
        "suggested_activity_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Activity Min"
        },
        "unknown_fields": {
          "items": {
            "enum": [
              "sleep_hours_last_night",
              "exercise_minutes_today",
              "alcohol_drinks_yesterday",
              "wellbeing",
              "sleep_hours",
              "exercise_minutes_weekly",
              "alcohol_drinks_weekly",
              "smoking_status",
              "weight_kg",
              "systolic_bp",
              "diastolic_bp",
              "sleep_hours_night_before",
              "vigorous_recreation_min",
              "moderate_recreation_min",
              "sedentary_min_day",
              "vigorous_recreation_min_week",
              "moderate_recreation_min_week"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unknown Fields",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "phase",
        "questions",
        "current_field",
        "previous",
        "confirmed",
        "pending",
        "early",
        "skipped_fields",
        "unknown_fields",
        "memory_consent",
        "probe_asked",
        "care_line_shown",
        "care_question_open",
        "probe_topic",
        "habit_notes",
        "local_date",
        "activity_day",
        "suggested",
        "suggested_activity_min",
        "from_health",
        "one_pace",
        "held_minutes",
        "checking",
        "reopened",
        "age_band"
      ],
      "title": "CheckinState",
      "type": "object"
    },
    "CheckinValues": {
      "additionalProperties": false,
      "description": "Answers from a daily or weekly check-in, in the profile's own units and ranges.\n\nWeekly answers use the profile's field names, so a caller can offer them as\nprofile updates. Daily answers are about one night or one day and have their\nown names, so they never pass for a usual week.",
      "properties": {
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "alcohol_drinks_yesterday": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Yesterday"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_today": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Today"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "moderate_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "sleep_hours_last_night": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Last Night"
        },
        "sleep_hours_night_before": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours Night Before"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        },
        "wellbeing": {
          "anyOf": [
            {
              "enum": [
                "good",
                "okay",
                "not_great"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wellbeing"
        }
      },
      "required": [
        "sleep_hours_last_night",
        "exercise_minutes_today",
        "alcohol_drinks_yesterday",
        "sleep_hours_night_before",
        "vigorous_recreation_min",
        "moderate_recreation_min",
        "sedentary_min_day",
        "vigorous_recreation_min_week",
        "moderate_recreation_min_week",
        "wellbeing",
        "sleep_hours",
        "exercise_minutes_weekly",
        "smoking_status",
        "alcohol_drinks_weekly",
        "weight_kg",
        "systolic_bp",
        "diastolic_bp"
      ],
      "title": "CheckinValues",
      "type": "object"
    },
    "DailyLogPart": {
      "additionalProperties": false,
      "description": "Part of one ``daily_logs`` row, in the package's names and units. Null means\nnot answered in this check-in. The app adds ``workday`` and keeps a day for the\nmodel only once all four values are known (see app/lib/checkin/README.md).",
      "properties": {
        "date": {
          "pattern": "\\d{4}-\\d{2}-\\d{2}",
          "title": "Date",
          "type": "string"
        },
        "moderate_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "vigorous_recreation_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min"
        }
      },
      "required": [
        "date",
        "sleep_hours",
        "vigorous_recreation_min",
        "moderate_recreation_min",
        "sedentary_min_day"
      ],
      "title": "DailyLogPart",
      "type": "object"
    },
    "HabitNote": {
      "additionalProperties": false,
      "description": "What the person said about a habit, in short words taken from their reply.\n\nNotes are never health values and are never used by the model. They are returned\nto the app, which keeps them on the phone; the server stores nothing.",
      "properties": {
        "barrier": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barrier"
        },
        "bedtime": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bedtime"
        },
        "concern": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concern"
        },
        "estimate": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate"
        },
        "estimate_for": {
          "anyOf": [
            {
              "enum": [
                "age",
                "sex",
                "height_cm",
                "weight_kg",
                "sleep_hours",
                "exercise_minutes_weekly",
                "smoking_status",
                "alcohol_drinks_weekly",
                "diabetes",
                "systolic_bp",
                "diastolic_bp",
                "general_health",
                "hypertension_diagnosed",
                "sedentary_min_day",
                "moderate_recreation_min_week",
                "vigorous_recreation_min_week"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate For"
        },
        "feeling": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feeling"
        },
        "frequency": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "kind": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "naps": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Naps"
        },
        "quit_ago": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quit Ago"
        },
        "quit_aid": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quit Aid"
        },
        "reading": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading"
        },
        "smoked_years": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoked Years"
        },
        "source": {
          "default": "said",
          "enum": [
            "said",
            "ai_helper"
          ],
          "title": "Source",
          "type": "string"
        },
        "time_of_day": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Of Day"
        },
        "topic": {
          "enum": [
            "exercise",
            "sleep",
            "smoking",
            "sitting",
            "health"
          ],
          "title": "Topic",
          "type": "string"
        },
        "tried_quitting": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tried Quitting"
        },
        "wake_time": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wake Time"
        },
        "wakes_for": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wakes For"
        },
        "with": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "With"
        }
      },
      "required": [
        "topic",
        "kind",
        "with",
        "time_of_day",
        "frequency",
        "barrier",
        "bedtime",
        "wake_time",
        "wakes_for",
        "naps",
        "smoked_years",
        "tried_quitting",
        "quit_aid",
        "quit_ago",
        "feeling",
        "concern",
        "reading",
        "estimate_for",
        "estimate",
        "source"
      ],
      "title": "HabitNote",
      "type": "object"
    },
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
