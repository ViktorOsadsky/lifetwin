  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The same shape as an onboarding turn: what to say, the state, and whether it's done.",
  "properties": {
    "accepted_input_modes": {
      "items": {
        "enum": [
          "text",
          "transcript"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Accepted Input Modes",
      "type": "array"
    },
    "client_action": {
      "anyOf": [
        {
          "const": "open_ideas",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Action"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "daily_logs": {
      "items": {
        "$ref": "#/$defs/DailyLogPart"
      },
      "maxItems": 2,
      "title": "Daily Logs",
      "type": "array"
    },
    "emergency": {
      "default": false,
      "title": "Emergency",
      "type": "boolean"
    },
    "guide_mode": {
      "const": "guided",
      "default": "guided",
      "title": "Guide Mode",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Limitations",
      "type": "array"
    },
    "mascot_events": {
      "items": {
        "$ref": "#/$defs/MascotEvent"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Mascot Events",
      "type": "array"
    },
    "message": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "profile_update": {
      "$ref": "#/$defs/HealthProfile"
    },
    "provider_status": {
      "const": "not_configured",
      "default": "not_configured",
      "title": "Provider Status",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "speech_hint": {
      "anyOf": [
        {
          "enum": [
            "slower",
            "louder"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speech Hint"
    },
    "state": {
      "$ref": "#/$defs/CheckinState"
    },
    "voice_status": {
      "default": "deferred",
      "enum": [
        "deferred",
        "available",
        "unavailable"
      ],
      "title": "Voice Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "state",
    "message",
    "guide_mode",
    "provider_status",
    "voice_status",
    "speech_hint",
    "client_action",
    "emergency",
    "profile_update",
    "daily_logs",
    "accepted_input_modes",
    "mascot_events",
    "complete",
    "limitations"
  ],
  "title": "CheckinResponse",
  "type": "object"
}
