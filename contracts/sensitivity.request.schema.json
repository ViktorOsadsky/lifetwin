{
  "$defs": {
    "HealthProfile": {
      "additionalProperties": false,
      "description": "Explicitly supplied metric inputs; no risk or lifespan inference.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age"
        },
        "alcohol_drinks_weekly": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alcohol Drinks Weekly"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diastolic_bp": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diastolic Bp"
        },
        "exercise_minutes_weekly": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Minutes Weekly"
        },
        "general_health": {
          "anyOf": [
            {
              "enum": [
                "excellent",
                "very_good",
                "good",
                "fair",
                "poor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "General Health"
        },
        "height_cm": {
          "anyOf": [
            {
              "maximum": 280,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "hypertension_diagnosed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypertension Diagnosed"
        },
        "moderate_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moderate Recreation Min Week"
        },
        "sedentary_min_day": {
          "anyOf": [
            {
              "maximum": 1439,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sedentary Min Day"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "sleep_hours": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Hours"
        },
        "smoking_status": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking Status"
        },
        "systolic_bp": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systolic Bp"
        },
        "vigorous_recreation_min_week": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vigorous Recreation Min Week"
        },
        "weight_kg": {
          "anyOf": [
            {
              "maximum": 700,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Kg"
        }
      },
      "title": "HealthProfile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/HealthProfile"
    }
  },
  "required": [
    "profile"
  ],
  "title": "SensitivityRequest",
  "type": "object"
}
