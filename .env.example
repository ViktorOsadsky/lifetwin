# All provider credentials and prediction configuration are intentionally blank.
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude by Anthropic (official SDK). With a key and LLM_PROVIDER / PERSONALIZE_PROVIDER
# left blank, Claude is used for the conversation guide, documents and Mochi's wording.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Conversation guide LLM: blank picks "anthropic" when ANTHROPIC_API_KEY is set, else
# "openai" (uses OPENAI_* above). "chat_completions" is any OpenAI-compatible
# /chat/completions endpoint. Muse example:
#   LLM_PROVIDER=chat_completions
#   LLM_BASE_URL=https://api.meta.ai/v1
#   LLM_MODEL=muse-spark-1.3   # a -contributor model needs LLM_ALLOW_CONTRIBUTOR=true
#   LLM_API_KEY=<your key, never commit>
LLM_PROVIDER=
# Meta may train on content sent to -contributor models (cheaper); they are refused unless true.
# LLM_ALLOW_CONTRIBUTOR=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# minimal keeps reasoning models from using the whole token budget before answering.
LLM_REASONING_EFFORT=minimal
# Outside-AI wording for Mochi's lines and suggestions: on, but only after the person's
# consent for this provider. Blank picks "claude" when ANTHROPIC_API_KEY is set, else
# "muse" (reuses the LLM_* settings).
PERSONALIZE_PROVIDER=
# Who reads and words onboarding, check-in and change turns (the AI helper): "claude",
# "muse" (LLM_PROVIDER + PERSONALIZE_PROVIDER as before) or "local" (no outside AI).
# Blank picks "claude" when ANTHROPIC_API_KEY is set (owner ruling 2026-10-25), even
# when LLM_PROVIDER or PERSONALIZE_PROVIDER name Muse; else "muse". Claude is reached only
# with outside_ai_consent {"claude": true} on the turn.
CONVERSATION_PROVIDER=
# 1 shortens the onboarding demo to one habit follow-up (questions and order unchanged).
ONBOARDING_DEMO=0
TAVILY_API_KEY=
# Folder with model.keras, preprocessor.joblib, baseline_hazard.csv, metrics.json (blank: repo root).
MODEL_ARTIFACT_PATH=
# Cartesia voice (Ink STT / Sonic TTS). The server mints short-lived tokens; the key stays here.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
CARTESIA_VOICE_ID=
CARTESIA_TTS_SPEED=0.9
CARTESIA_TOKEN_TTL_SECONDS=300

APP_ENV=development
API_PROVIDER_TIMEOUT_SECONDS=12
API_REQUEST_TIMEOUT_SECONDS=25
API_MAX_BODY_BYTES=32768
# Document text route only (10 pages of recognised text).
API_MAX_DOCUMENT_BODY_BYTES=393216
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_REQUESTS=16
# Exact browser origins only, comma-separated. Native Flutter does not need CORS.
CORS_ORIGINS=
# Muse for document text: off until the owner rules (docs/document-upload.md).
DOCUMENT_MUSE_ENABLED=true
