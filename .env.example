# All provider credentials and prediction configuration are intentionally blank.
OPENAI_API_KEY=
OPENAI_MODEL=
# Owner ruling (2026-10-25): "switch out to Claude API officially". Claude by Anthropic is
# the AI provider for every call (conversation turns, PDFs and document text, ideas and
# recommendations, the coach plan, check-in care replies), always only after the person's
# yes for Claude (outside_ai_consent {"claude": true}). Leave the *_PROVIDER settings blank
# for Claude. Without ANTHROPIC_API_KEY nothing goes to an outside AI: the rules answer.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# AI helper: blank is "anthropic" (Claude). "chat_completions" (Muse by Meta, LLM_* below)
# and "openai" (OPENAI_* above) are explicit opt-ins, used only by a route that also names
# Muse (CONVERSATION_PROVIDER=muse or DOCUMENT_PROVIDER=muse). Muse opt-in example:
#   LLM_PROVIDER=chat_completions
#   LLM_BASE_URL=https://api.meta.ai/v1
#   LLM_MODEL=muse-spark-1.3   # a -contributor model needs LLM_ALLOW_CONTRIBUTOR=true
#   LLM_API_KEY=<your key, never commit>
LLM_PROVIDER=
# Muse opt-in only: Meta may train on content sent to -contributor models (cheaper); they
# are refused unless true. Claude never needs this.
# LLM_ALLOW_CONTRIBUTOR=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# minimal keeps reasoning models from using the whole token budget before answering.
LLM_REASONING_EFFORT=minimal
# Wording for ideas/recommendations and the coach plan: blank is "claude"; "muse" (reuses
# the LLM_* settings) is an explicit opt-in.
PERSONALIZE_PROVIDER=
# Who reads and words onboarding, check-in and change turns (the AI helper): blank is
# "claude"; "local" calls no outside AI; "muse" (explicit opt-in) uses LLM_PROVIDER and
# PERSONALIZE_PROVIDER.
CONVERSATION_PROVIDER=
# Who reads a chosen PDF and helps with recognised document text: blank is "claude";
# "local" calls no outside AI; "muse" (explicit opt-in, with LLM_PROVIDER=chat_completions)
# helps with recognised text only.
DOCUMENT_PROVIDER=
# 1 shortens the onboarding demo to one habit follow-up (questions and order unchanged).
ONBOARDING_DEMO=0
TAVILY_API_KEY=
# Folder with model.keras, preprocessor.joblib, baseline_hazard.csv, metrics.json (blank: repo root).
MODEL_ARTIFACT_PATH=
# Cartesia voice (Ink STT / Sonic TTS). The server mints short-lived tokens; the key stays here.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
CARTESIA_VOICE_ID=
CARTESIA_TTS_SPEED=0.9
CARTESIA_TOKEN_TTL_SECONDS=300

APP_ENV=development
API_PROVIDER_TIMEOUT_SECONDS=12
API_REQUEST_TIMEOUT_SECONDS=25
API_MAX_BODY_BYTES=32768
# Document text route only (10 pages of recognised text).
API_MAX_DOCUMENT_BODY_BYTES=393216
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_REQUESTS=16
# Exact browser origins only, comma-separated. Native Flutter does not need CORS.
CORS_ORIGINS=
# The outside AI may read identifier-stripped document text (with consent); false turns it off.
DOCUMENT_MUSE_ENABLED=true
